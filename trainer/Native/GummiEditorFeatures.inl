       !isfinite(v.pitch) || !isfinite(v.yaw) || fabsf(v.pitch)>2*Turn || fabsf(v.yaw)>2*Turn ||
       !TaskList(v,false) || !TaskList(v,true) || !NamedCamera(v))return false;
    result=v;return true;
}
bool Same(const View& a,const View& b) {
    return a.editor==b.editor && a.work==b.work && a.camera==b.camera && a.cursor==b.cursor &&
        a.manager==b.manager && a.objects==b.objects && a.heap==b.heap && a.partHeap==b.partHeap &&
        a.editTask==b.editTask && a.workTask==b.workTask && a.cameraTask==b.cameraTask && a.cursorTask==b.cursorTask &&
        a.fiber==b.fiber && a.registry==b.registry && a.phase==b.phase && a.mode==b.mode &&
        a.material==b.material && a.tiny==b.tiny && a.editorVtable==b.editorVtable;
}
bool Idle(const View& v) { return v.moduleState==1 && !v.inputLock && v.remaining<=0 && !(v.cameraFlags&0x20); }
bool Positive(float f) { return isfinite(f) && f>0; }
bool Projection(const View& v,float angle) {
    const float width=F<float>(v.camera,92),height=F<float>(v.camera,96);
    if(!Positive(width) || !Positive(height) || !Positive(F<float>(v.camera,80)) ||
       !Positive(F<float>(v.camera,88)) || F<float>(v.camera,88)>=Pi || !Positive(angle) || angle>=Pi)return false;
    // Float intermediates match 19DDE0; no arbitrary viewport pixel limit.
    const float tangent=tanf(angle*.5f),x=(512.f/width)*.5f,y=(416.f/height)*.5f;
    const float focal=x/tangent,ratio=y/focal,vertical=2.f*atanf(ratio);
    return Positive(tangent) && Positive(x) && Positive(y) && Positive(focal) && Positive(ratio) && Positive(vertical) && vertical<Pi;
