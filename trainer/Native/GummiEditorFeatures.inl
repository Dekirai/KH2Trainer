bool VectorFinite(uintptr_t p,unsigned count=4) { for(unsigned i=0;i<count;++i)if(!isfinite(F<float>(p,4*i)))return false;return true; }
bool Angles(uintptr_t p,float bound) {
    if(!VectorFinite(p))return false;
    for(unsigned i=0;i<3;++i)if(fabsf(F<float>(p,4*i))>bound)return false;
    return true;
}
bool WeightedVectorFinite(uintptr_t p) {
    if(!VectorFinite(p))return false;
    for(unsigned i=0;i<4;++i) {
        const float bound=fabsf(F<float>(p,4*i));
        if(!isfinite(bound*20.f+bound*20.f))return false;
    }
    return true;
}
bool FocusReady(const View& v) {
    if(!WeightedVectorFinite(v.work+32))return false;
    if(v.cameraFlags&1)return WeightedVectorFinite(v.camera+2560) && WeightedVectorFinite(v.camera+2576);
    if((F<unsigned>(v.cursor,16)&4) || !F<int>(v.cursor,2840))return true;
    // 2641D0 touches only these inline GRID values, not cell/part lists.
    const int plane=F<int>(v.work,6240);
    if(plane<0 || plane>2 || !WeightedVectorFinite(v.work+6200) || !VectorFinite(v.work+6168,3) ||
       !VectorFinite(v.cursor+1072,3) || !VectorFinite(v.cursor+1120,3))return false;
    const bool adjust=!(F<unsigned>(v.cursor,2976)&4);
    if(adjust && !VectorFinite(v.work+16,3))return false;
    for(unsigned i=0;i<3;++i) {
        const float position=F<float>(v.cursor,1072+4*i)+F<float>(v.cursor,1120+4*i);
        if(!isfinite(position))return false;
        const float half=adjust?F<float>(v.work,16+4*i)*.5f:0;
        // Both signs are safe for the rotation-selected view direction.
        const float lo=position-half,hi=position+half;
        if(!isfinite(lo) || !isfinite(hi))return false;
        const float bound=fmaxf(fmaxf(fabsf(lo),fabsf(hi)),fmaxf(fabsf(F<float>(v.work,6200+4*i)),fabsf(F<float>(v.work,6168+4*i))));
        // Native transition weights reach20. Check their finite envelope;
        // this is not an arbitrary small editor-coordinate restriction.
        if(!isfinite((bound*20.f)+(bound*20.f)))return false;
    }
    return true;
}
bool ResetReady(const View& v) {
    if(!Writable(reinterpret_cast<void*>(v.camera),CameraBytes) ||
       !Angles(v.camera+2448,2*Turn) || !Angles(v.camera+2480,2*Turn) ||
       !Angles(v.camera+2464,Turn) || !Projection(v,v.fov) || !Projection(v,F<float>(v.camera,2592)))return false;
    if(v.mode==1)return true;
    if(!Projection(v,F<float>(v.camera,2596)) || !Projection(v,F<float>(v.camera,2600)))return false;
    if(!ReadSpan(g_base+0x73DD10,16) || !Angles(g_base+0x73DD10,Turn))return false;
    float threshold=0,snap=0;
    if(!Global(0x73DCD8,threshold) || !Global(0x73DCD4,snap) || !Positive(threshold) || threshold>Pi*.5f ||
       !Positive(snap) || snap>Pi*.5f)return false;
    return FocusReady(v);
}
bool FovReady(const View& v,float radians) {
    return v.phase==4 && v.mode==1 && Writable(reinterpret_cast<void*>(v.camera+80),12) && Projection(v,radians);
}
void CallReset(uintptr_t camera) {
#ifdef KH2_GUMMI_EDITOR_TESTS
    testReset(reinterpret_cast<void*>(camera),10);
#else
    reinterpret_cast<ResetFn>(g_base+0x290900)(reinterpret_cast<void*>(camera),10);
#endif
}
void CallFov(uintptr_t camera,float radians) {
#ifdef KH2_GUMMI_EDITOR_TESTS
    testFov(reinterpret_cast<void*>(camera+16),radians,0);
#else
    reinterpret_cast<FovFn>(g_base+0x19DDE0)(reinterpret_cast<void*>(camera+16),radians,0);
#endif
}
