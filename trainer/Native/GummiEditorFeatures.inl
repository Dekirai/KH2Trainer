bool GummiEditorHandle(const TrainerContext& host,unsigned slot,const double args[8],TrainerResult& result) {
    if(slot!=424 && slot!=425)return false;
    result={1,L"Open a Gummi or Teeny Ship editor and wait for its current view transition to finish."};
    if(host.base!=g_base || !gummi_editor::HostReady())return true;
    if(!args){result={2,L"Command arguments are missing."};return true;}
    for(unsigned i=0;i<8;++i)if(!isfinite(args[i])){result={2,L"Command arguments must be finite."};return true;}
    if(slot==425 && (args[0]<20 || args[0]>90)){result={2,L"Preview FOV must be between 20 and 90 degrees."};return true;}
    const float radians=static_cast<float>(args[0]*(3.14159265358979323846/180.));
    gummi_editor::View before{},now{};
    if(!gummi_editor::Build(before) || !gummi_editor::Idle(before) ||
       !(slot==424?gummi_editor::ResetReady(before):gummi_editor::FovReady(before,radians)) || !gummi_editor::CodeReady())return true;
    // Rebuild all owners, both complete scheduler lists, registry and numeric
    // preflight before dispatch. Never inspect borrowed engine state afterward.
    if(!gummi_editor::Build(now) || !gummi_editor::Same(before,now) || !gummi_editor::Idle(now) ||
       !(slot==424?gummi_editor::ResetReady(now):gummi_editor::FovReady(now,radians)) ||
       !gummi_editor::CodeReady() || !gummi_editor::HostReady()) {
        result={3,L"The Gummi editor changed during validation. Retry in the current editor view."};return true;
    }
    if(slot==424)gummi_editor::CallReset(now.camera);else gummi_editor::CallFov(now.camera,radians);
    result={0,slot==424?L"Native editor view reset requested. A view already at its baseline stays unchanged.":
        L"Preview FOV changed once. Native zoom input and view reset remain in control."};
    return true;
}
void GummiEditorSnapshot(const TrainerContext& host) {
    gummi_editor::View v{};
    if(host.base!=g_base || !gummi_editor::HostReady() || !gummi_editor::Build(v))return;
    SnapshotValue(426,v.phase);SnapshotValue(427,v.fov*(180./3.14159265358979323846));
    SnapshotValue(428,v.pitch*(180./3.14159265358979323846));SnapshotValue(429,v.yaw*(180./3.14159265358979323846));
    SnapshotValue(430,v.remaining);
}
void GummiEditorCapabilities() { for(unsigned slot=424;slot<=430;++slot)SupportCapability(slot); }
