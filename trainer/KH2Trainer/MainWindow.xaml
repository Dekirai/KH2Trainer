<Window x:Class="KH2Trainer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:KH2Trainer" Style="{StaticResource {x:Type Window}}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" Title="KH2 Trainer" Width="1320" Height="880" MinWidth="1060" MinHeight="710" WindowStartupLocation="CenterScreen">
 <Grid Background="{StaticResource BackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
   <DockPanel Margin="18,28,18,20">
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,28"><TextBlock Text="KH2" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="TRAINER" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="FINAL MIX · PC" Style="{StaticResource Label}" Margin="0,12,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="8,24,0,0"><TextBlock Text="Steam 1.0.0.2 · x64" Style="{StaticResource Label}"/><TextBlock Text="F10 · Developer tools" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding BuildLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/></StackPanel>
    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="13,11"/><Setter Property="Margin" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Nav" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="#29443F"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#273448"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,25,30,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="108"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedCategory}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,6,16,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal"><Button Content="Start game" Command="{Binding StartGameCommand}"/><Button Content="{Binding ConnectLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}" MinWidth="120"/></StackPanel></Grid>
   <Border Grid.Row="1" Background="#192331" CornerRadius="8" Padding="14,11" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding ConnectionDetail}" Foreground="{StaticResource MutedBrush}" Margin="20,0,0,0" VerticalAlignment="Center"/></Grid></Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <local:AssetExplorerView DataContext="{Binding Assets}" Visibility="{Binding DataContext.IsAssets,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource BoolVisibility}}"/>
     <local:RuntimeDiagnosticsView DataContext="{Binding Diagnostics}" Visibility="{Binding DataContext.IsDiagnostics,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource BoolVisibility}}"/>
     <StackPanel Visibility="{Binding IsOverview,Converter={StaticResource BoolVisibility}}">
      <UniformGrid Columns="3" Margin="0,0,-12,20">
       <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="HEALTH" Style="{StaticResource Label}"/><TextBlock Text="{Binding HealthText}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Current player" Style="{StaticResource Label}" Margin="0,6,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="MAGIC" Style="{StaticResource Label}"/><TextBlock Text="{Binding MagicText}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Current player" Style="{StaticResource Label}" Margin="0,6,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="DRIVE" Style="{StaticResource Label}"/><TextBlock Text="{Binding DriveText}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Current gauge" Style="{StaticResource Label}" Margin="0,6,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Your session" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Start the game, load a playable scene, and connect. Choose a section to inspect live values or apply a trainer feature." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,16"/><ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" DisplayMemberPath="Label" MaxWidth="680" HorizontalAlignment="Left" MinWidth="400"/><TextBlock Text="{Binding SessionSummary}" TextWrapping="Wrap" Margin="0,16,0,16" Foreground="{StaticResource MutedBrush}"/><WrapPanel><Button Content="Show developer tools" Command="{Binding ShowDebugCommand}"/><Button Content="Disable all effects" Command="{Binding DisableEffectsCommand}"/><Button Content="Browse research" Command="{Binding OpenResearchCommand}"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Training without surprises" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Temporary effects stop when the trainer disconnects. Inventory, stats and progression actions change the loaded game state; saving in the game can make those changes permanent. Create a backup before experimenting with progression." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding IsFeaturePage,Converter={StaticResource BoolVisibility}}">
      <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search features by name or description" Margin="0,0,0,18"/>
      <TextBlock Text="{Binding FeatureCountText}" Style="{StaticResource Label}"/>
      <ItemsControl ItemsSource="{Binding VisibleFeatures}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="340" Margin="0,0,14,14"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding LiveValue}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="10,0,0,0" MaxWidth="110" TextWrapping="Wrap"/></Grid>
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,16" MinHeight="38"/>
        <StackPanel Visibility="{Binding IsNumber,Converter={StaticResource BoolVisibility}}"><DockPanel Margin="0,0,0,12"><TextBox Text="{Binding ValueText,UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left"/><TextBlock Text="{Binding RangeText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center"/></DockPanel></StackPanel>
        <ComboBox Visibility="{Binding IsChoice,Converter={StaticResource BoolVisibility}}" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Label" Margin="0,0,0,12"/>
        <CheckBox Visibility="{Binding IsToggle,Converter={StaticResource BoolVisibility}}" IsChecked="{Binding ToggleValue}" Content="Enabled"/>
        <ItemsControl ItemsSource="{Binding Arguments}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Name}" Style="{StaticResource Label}"/><TextBox Text="{Binding ValueText,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsNumber,Converter={StaticResource BoolVisibility}}"/><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Label" IsEditable="True" IsTextSearchEnabled="True" Visibility="{Binding IsChoice,Converter={StaticResource BoolVisibility}}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Button Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Visibility="{Binding IsEditable,Converter={StaticResource BoolVisibility}}"/>
        <TextBlock Text="{Binding Availability}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
       </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
     <StackPanel Visibility="{Binding IsProfiles,Converter={StaticResource BoolVisibility}}"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Reusable settings" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Profiles contain supported numeric settings and toggles. One-shot progression actions are never replayed by a profile." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,20"/><TextBlock Text="Profile name" Style="{StaticResource Label}"/><TextBox Text="{Binding ProfileName}" MaxWidth="450" HorizontalAlignment="Left" MinWidth="300" Margin="0,0,0,16"/><WrapPanel><Button Content="Save current settings" Command="{Binding SaveProfileCommand}"/><Button Content="Load profile…" Command="{Binding LoadProfileCommand}"/><Button Content="Apply loaded profile" Command="{Binding ApplyProfileCommand}"/></WrapPanel><TextBlock Text="{Binding ProfileSummary}" TextWrapping="Wrap" Margin="0,20,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border></StackPanel>
     <StackPanel Visibility="{Binding IsSaves,Converter={StaticResource BoolVisibility}}"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Save backups" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Choose your KH2 save folder to create a dated, checksummed backup. Close the game before creating or restoring a backup." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,20"/><TextBox Text="{Binding SaveFolder}" Margin="0,0,0,16"/><WrapPanel><Button Content="Choose folder…" Command="{Binding ChooseSaveFolderCommand}"/><Button Content="Create backup" Command="{Binding BackupCommand}"/><Button Content="Restore backup…" Command="{Binding RestoreBackupCommand}"/><Button Content="Open backups" Command="{Binding OpenBackupsCommand}"/></WrapPanel><TextBlock Text="{Binding BackupSummary}" TextWrapping="Wrap" Margin="0,20,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border></StackPanel>
     <StackPanel Visibility="{Binding IsResearch,Converter={StaticResource BoolVisibility}}"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Implementation evidence" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="The trainer is tied to one verified game build. Every feature in its catalog links to the code or data structure used by its implementation. Automatic function coverage and confirmed runtime behavior are tracked separately." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,20"/><TextBlock Text="{Binding ResearchSummary}" TextWrapping="Wrap" Margin="0,0,0,20"/><WrapPanel><Button Content="Open user guide" Command="{Binding OpenGuideCommand}"/><Button Content="Open IDA analysis" Command="{Binding OpenAnalysisCommand}"/><Button Content="Export feature evidence" Command="{Binding ExportEvidenceCommand}"/><Button Content="Export session log" Command="{Binding ExportLogCommand}"/></WrapPanel></StackPanel></Border></StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="SESSION ACTIVITY" Style="{StaticResource Label}"/><ListBox ItemsSource="{Binding RecentActivity}" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0" FontSize="12" IsHitTestVisible="False"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
