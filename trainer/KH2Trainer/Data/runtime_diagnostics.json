          "SecondaryButtonAddress": "0x1405b04c8",
          "RecordAddress": "0x1407148b0"
        },
        {
          "LanguageId": 1,
          "Text": "The Epic Games Launcher is in Offline Mode.\nPlease check your internet connection.",
