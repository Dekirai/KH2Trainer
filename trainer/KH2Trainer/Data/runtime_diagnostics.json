          "PrimaryButtonAddress": "0x1405afb00",
          "SecondaryButtonAddress": "0x1405b0658",
          "RecordAddress": "0x1407148f0"
        },
        {
          "LanguageId": 3,
          "Text": "Il launcher di Epic Games è in modalità offline.\nVerifica la tua connessione Internet.",
