          "PrimaryButton": "OK",
          "SecondaryButton": null,
          "TextAddress": "0x1405af710",
          "PrimaryButtonAddress": "0x1405aee00",
          "SecondaryButtonAddress": null,
          "RecordAddress": "0x140714550"
        },
        {
