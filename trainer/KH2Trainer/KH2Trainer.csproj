<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>KH2_Trainer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.12.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KH2Trainer.Core/KH2Trainer.Core.csproj" />
    <EmbeddedResource Include="Data/*.json">
      <LogicalName>KH2Trainer.Data.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../Native/build/KH2Trainer.Bridge.dll" LogicalName="KH2Trainer.Bridge" Condition="Exists('../Native/build/KH2Trainer.Bridge.dll')" />
  </ItemGroup>
  <Target Name="RequireNativeBridge" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../Native/build/KH2Trainer.Bridge.dll')" Text="Build the native bridge first with trainer/build-native.cmd." />
  </Target>
</Project>
