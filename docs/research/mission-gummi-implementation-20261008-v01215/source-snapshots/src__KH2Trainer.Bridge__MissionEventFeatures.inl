}
bool EventsReady(const TrainerContext& c,const View& v) {
    if(At<uintptr_t>(0x2A250B0) || At<uintptr_t>(0x2A25048) ||
        At<uintptr_t>(0x2A250A0)!=v.heap || !Range(v.heap,128) ||
        !Writable(reinterpret_cast<void*>(v.heap),128) ||
        Field<uintptr_t>(v.heap,0)!=g_base+0x5B2BB0 ||
        At<uintptr_t>(0x5B2BB8)!=g_base+0x19C2B0 || At<uintptr_t>(0x5B2BC0)!=g_base+0x19C470 ||
        !At<uintptr_t>(0xAC0FD8)) return false;
