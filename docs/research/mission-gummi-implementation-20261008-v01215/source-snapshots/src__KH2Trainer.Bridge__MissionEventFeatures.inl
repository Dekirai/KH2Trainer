    uintptr_t seen[2048]{}; unsigned count=0;
    uintptr_t tail=0;
    for(uintptr_t node=At<uintptr_t>(0x2A25090);node;node=DecodePacked(Field<uint32_t>(node,68))) {
        if(count==2048 || !ScriptReady(node)) return false;
        for(unsigned i=0;i<count;++i) if(seen[i]==node) return false;
        seen[count++]=node; tail=node;
    }
