}
void Native(unsigned slot,unsigned index,int integer,float floating,uintptr_t score) {
#ifdef KH2_MISSIONEVENT_TESTS
    if(slot==230) { if(testCounter) testCounter(integer,static_cast<int>(index)); }
    else if(slot==231) { if(testGauge) testGauge(floating,static_cast<int>(index)); }
    else if(testScore) testScore(score,integer);
#else
    if(slot==230) reinterpret_cast<CounterFn>(g_base+0x3FBAE0)(integer,static_cast<int>(index));
    else if(slot==231) reinterpret_cast<GaugeFn>(g_base+0x3FBCB0)(floating,static_cast<int>(index));
    else reinterpret_cast<ScoreFn>(g_base+0x3FA230)(score,integer);
#endif
}
}
bool MissionEventHandle(const TrainerContext& c,unsigned slot,const double args[8],TrainerResult& result) {
    using namespace mission_event_features;
    const bool delta=slot==mission_counter::DeltaSlot,digit=slot==mission_counter::DigitSlot;
    const bool derived=delta || digit;
    if((slot<230 || slot>232) && !derived) return false;
    for(unsigned i=0;i<8;++i) if(!isfinite(args[i])) { result={1,L"Mission arguments must be finite."}; return true; }
    const bool score=slot==232,gauge=slot==231;
    if(!score && !IsInteger(args[0],0,2)) { result={1,L"Choose configured counter or gauge index 0, 1 or 2."}; return true; }
    const unsigned index=score?0:static_cast<unsigned>(args[0]);
    double value=args[score?0:1];
    if((delta && !IsInteger(args[1],INT32_MIN,INT32_MAX)) ||
        (digit && (!IsInteger(args[1],0,9) || !IsInteger(args[2],0,9)))) {
        result={1,L"Use a whole signed 32-bit delta, or a decimal position 0..9 and digit 0..9."}; return true;
    }
    if(!derived && ((!gauge && !IsInteger(value,0,score?9999:2147483647.0)) || (gauge && (value<0 || value>2147483520.0)))) {
        result={1,L"Choose a nonnegative value within the active widget's maximum; counters and score require whole numbers."}; return true;
    }
    View before{},fresh{}; Widget widget{},current{};
    if(!mission_features::ReadView(c,before) || !Stable(c,before) || !ReadWidget(before,slot,index,widget) || (!derived && value>widget.maximum)) {
        result={1,L"This action needs a configured widget and living player in stable, unpaused mission gameplay."}; return true;
    }
    if(derived) {
        int32_t target=0;
        const int32_t old=static_cast<int32_t>(widget.valueBits); // ReadWidget proved 0..maximum.
        const bool valid=delta ? mission_counter::Delta(old,widget.maximum,static_cast<int32_t>(args[1]),target) :
            mission_counter::Digit(old,widget.maximum,static_cast<unsigned>(args[1]),static_cast<unsigned>(args[2]),target);
        if(!valid) { result={1,L"The calculated counter value is outside 0..configured maximum or signed 32-bit range. Nothing was called."}; return true; }
        value=target;
    }
    const float floating=static_cast<float>(value);
    const double delivered=gauge?static_cast<double>(floating):value;
    // Derived commands always require the full event preflight, including when
    // the calculated absolute target does not cross a boundary.
    const bool event=derived || Boundary(widget,gauge,delivered);
    if(!CodeReady() || (event && !EventsReady(c,before))) {
        result={1,L"Native mission code, event lists, script contexts or widget resources are not ready."}; return true;
    }
    if(!mission_features::ReadView(c,fresh) || !mission_features::SameView(before,fresh) || !Stable(c,fresh) ||
        !ReadWidget(fresh,slot,index,current) || !SameWidget(widget,current) ||
        (event && !EventsReady(c,fresh)) || !mission_features::Allowed()) {
        result={1,L"Mission state changed before the action; nothing was called."}; return true;
    }
    Native(derived?230:slot,index,gauge?0:static_cast<int>(value),floating,current.pointer);
    // Discard every old pointer after the call. Boundary scripts may have ended
    // the mission, awarded progression, changed actors or scheduled a new room.
    // Native AL is unspecified. This acknowledges dispatch, not universal win.
    result={0,score ? L"Native score setter called once. Reward multipliers/history remain unchanged; later native EXP and mission effects apply." :
        L"Native mission setter called once. Boundary events, rewards and mission transitions remain active; no undo or automatic retry."};
    return true;
}
void MissionEventCapabilities() {
    for(unsigned i=230;i<=232;++i) SupportCapability(i);
    SupportCapability(mission_counter::DeltaSlot); SupportCapability(mission_counter::DigitSlot);
}
