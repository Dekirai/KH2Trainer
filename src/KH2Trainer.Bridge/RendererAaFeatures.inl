    if(!Query(site,m) || m.State!=MEM_COMMIT || m.Type!=MEM_IMAGE || m.AllocationBase!=reinterpret_cast<void*>(g_base) ||
        m.Protect!=PAGE_EXECUTE_READ || reinterpret_cast<uintptr_t>(m.BaseAddress)>g_base+SiteRva ||
        m.RegionSize<5 || g_base+SiteRva-reinterpret_cast<uintptr_t>(m.BaseAddress)>m.RegionSize-5)return false;
