bool RendererAaHandle(const TrainerContext& c,unsigned slot,const double args[8],TrainerResult& result) {
    using namespace renderer_aa;
    if(slot<First || slot>Last)return false;
    if(slot>448){result={1,L"This MSAA value is read-only."};return true;}
    if(!g_gameThread || GetCurrentThreadId()!=g_gameThread){result={1,L"MSAA actions require the application update thread."};return true;}
    if(slot==448){Off();result={0,L"Native MSAA adaptation resumed. The resident hook now passes through; changes can take several frames."};return true;}
    if(!args || !IsInteger(args[0],1,2) || !(args[1]==1 || args[1]==2 || args[1]==4 || args[1]==8)) {
        result={1,L"Choose Fixed or Maximum, and 1, 2, 4 or 8 samples."};return true;
    }
    Off(); // a valid new request replaces the old policy even if preparation fails
    if(!LifetimeIntact()){Fault();result={1,L"The renderer lifetime changed. MSAA policy requires a game restart."};return true;}
    Lease before{};
    if(!LeaseReady(c,before)){Off();result={1,L"MSAA needs the original supported renderer, a fresh connection and a live application thread."};return true;}
    const int beforeEpoch=Field<int>(g_base+display_preview::EpochRva);
    FILETIME beforeApp{},beforeTiming{};
    if(!CreationTimes(before,beforeApp,beforeTiming)){result={1,L"Renderer thread identity is unavailable."};return true;}
    if(Lock(before)!=0){result={1,L"The native presentation mutex could not be acquired."};return true;}
    bool accepted=false;
    __try {
        Lease after{};int maximum=0,current=0;FILETIME app{},timing{};
        if(LeaseReady(c,after) && display_preview::Same(before,after) && Limits(after.object,maximum,current) &&
            Field<int>(after.object,22944)==0 && Field<int>(after.object,1072)==0 && CreationTimes(after,app,timing) &&
            beforeEpoch==Field<int>(g_base+display_preview::EpochRva) &&
            !memcmp(&app,&beforeApp,sizeof(app)) && !memcmp(&timing,&beforeTiming,sizeof(timing)) && Install()) {
            lifetime=after;lifetimeEpoch=Field<int>(g_base+display_preview::EpochRva);
            appCreated=app;timingCreated=timing;lifetimeBound=true;requested=args[1]==1?0:args[1]==2?1:args[1]==4?2:3;
            decisionValid=false;InterlockedExchange(&mode,static_cast<LONG>(args[0]));accepted=true;
        }
