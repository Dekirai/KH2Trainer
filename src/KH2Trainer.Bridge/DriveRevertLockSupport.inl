bool Same(const Binding& a,const Binding& b) {
    return a.bar==b.bar && a.table==b.table && a.row==b.row && a.entry==b.entry && a.bytes==b.bytes &&
        !memcmp(a.allocation,b.allocation,sizeof(a.allocation)) && !memcmp(a.barHeader,b.barHeader,sizeof(a.barHeader)) &&
        !memcmp(a.entryBytes,b.entryBytes,sizeof(a.entryBytes)) && !memcmp(a.tableHeader,b.tableHeader,sizeof(a.tableHeader)) &&
        !memcmp(a.rowBytes,b.rowBytes,sizeof(a.rowBytes));
}
void Forget() { lease={}; }
void Cleanup(const TrainerContext& c) {
    if(!lease.state)return;
    lease.state=2;
    if(!Thread(c) || bridgeBase!=g_base)return;
    Binding current;
    if(!ReadBinding(current))return; // retry unreadable/unavailable current binding
    if(!Same(current,lease.binding)) {Forget();return;}
    const uint16_t mask=Field<uint16_t>(current.row,44);
    if(mask!=lease.expected) {Forget();return;} // foreign change is never rewritten
    if(!lease.added) {Forget();return;}
    if(!Writable(reinterpret_cast<void*>(current.row+44),2))return;
    const SHORT desired=static_cast<SHORT>(mask&~lease.added);
    // A racing mask update cannot be overwritten between read and store.
    InterlockedCompareExchange16(reinterpret_cast<volatile SHORT*>(current.row+44),desired,static_cast<SHORT>(mask));
    Forget(); // CAS failure is a foreign replacement, not permission to retry it
}
void Tick(const TrainerContext& c) {
    if(!lease.state)return; // no BAR/table scans when idle
    if(lease.state==2 || !AllowedThread()) {Cleanup(c);return;}
    if(!Thread(c))return;
    Binding current;
    if(!CodeReady() || !ReadBinding(current)) {lease.state=2;return;}
    if(!Same(current,lease.binding) || Field<uint16_t>(current.row,44)!=lease.expected)Forget();
}
bool Handle(const TrainerContext& c,const double args[8],TrainerResult& result) {
    result={2,L"Use release/acquire plus exact owner and bridge halves; trailing arguments must be zero."};
    if(!args || !IsInteger(args[0],0,1))return true;
    for(unsigned i=1;i<5;++i)if(!IsInteger(args[i],0,4294967295.0))return true;
    for(unsigned i=5;i<8;++i)if(args[i]!=0)return true;
    const uint64_t owner=static_cast<uint32_t>(args[1])|(uint64_t(static_cast<uint32_t>(args[2]))<<32);
    const uint64_t requestedBridge=static_cast<uint32_t>(args[3])|(uint64_t(static_cast<uint32_t>(args[4]))<<32);
    if(!owner || !requestedBridge)return true;
    if(!Identity(c) || requestedBridge!=bridge) {result={3,L"The Drive lock belongs to another bridge session or update thread."};return true;}
    if(args[0]==0) {
        if(lease.state && lease.owner!=owner) {
            result={0,L"This effect no longer owns the Revert lock; the current owner's lock is unchanged."};return true;
        }
        Cleanup(c);
        result={0,lease.state?L"Revert unlock is pending until its owned table is writable and verifiable.":L"Owned Revert lock released or already absent."};return true;
    }
    if(lease.state && lease.owner!=owner) {result={3,L"Another effect owns the Drive Revert lock."};return true;}
    if(!AllowedThread() || !LiveScene(c) || !CodeReady()) {result={3,L"A fresh connection and stable normal Sora scene are required for a Revert lock."};return true;}
    const bool previouslyOwned=lease.state!=0;
    Tick(c);
    if(previouslyOwned && !lease.state) {result={3,L"The prior Revert lock was superseded by a changed command table."};return true;}
    if(lease.state==2) {result={3,L"Prior Revert lock cleanup is still pending."};return true;}
    if(lease.state==1) {result={0,L"This effect already owns the Revert lock."};return true;}
    Binding current;
    if(!ReadBinding(current) || !Writable(reinterpret_cast<void*>(current.row+44),2)) {
        result={3,L"The native Revert command table is unavailable or not writable."};return true;
    }
    const uint16_t prior=Field<uint16_t>(current.row,44),expected=prior|FormMask;
    if(InterlockedCompareExchange16(reinterpret_cast<volatile SHORT*>(current.row+44),static_cast<SHORT>(expected),static_cast<SHORT>(prior))!=static_cast<SHORT>(prior)) {
        result={3,L"The Revert command changed before the lock could be acquired."};return true;
    }
    lease={1,owner,current,static_cast<uint16_t>(FormMask&~prior),expected};
    result={0,L"Native Revert is blocked for Drive Forms while this effect owns the lock."};return true;
}
void Snapshot(const TrainerContext& c) {
    Identity(c);
    Tick(c); // publish only after checking an active binding on this update thread
    SnapshotValue(Slot,lease.state);
    SnapshotValue(Slot+1,static_cast<uint32_t>(lease.owner));SnapshotValue(Slot+2,static_cast<uint32_t>(lease.owner>>32));
    const uint64_t id=bridgeBase==g_base?bridge:0;
    SnapshotValue(Slot+3,static_cast<uint32_t>(id));SnapshotValue(Slot+4,static_cast<uint32_t>(id>>32));
}
