bool ReadBinding(Binding& out) {
#ifdef KH2_DRIVE_TESTS
    ++testScans;
#endif
    out={};
    // Bound every candidate to the original image-resident system arena before
    // using the shared BAR parser. Its initialization cursor is normally zero.
    if(g_base>UINTPTR_MAX-kh2dev::kImageSize)return false;
    const uintptr_t start=g_base+ArenaRva,end=g_base+kh2dev::kImageSize;
    const uintptr_t bar=At<uintptr_t>(BarRva);
    if(bar<start+16 || bar>end || !Range(bar-16,32))return false;
    const unsigned bytes=Field<unsigned>(bar-16,0);
    if(bytes>end-bar)return false;
    WeaponSpan span;
    if(!SystemTableSpan(0x00646D63,TableRva,span) || span.size<8)return false;
    const int count=Field<int>(span.data,4);
    if(count<=0 || count>65536 || uint64_t(count)*48+8>span.size)return false;
    uintptr_t row=0;unsigned previous=0;
    for(int i=0;i<count;++i) {
        const uintptr_t r=span.data+8+SIZE_T(i)*48;
        const unsigned id=Field<uint16_t>(r,0);
        if(i && id<=previous)return false;
        previous=id;
        if(id==5)row=r;
    }
    // A terminal id5/kind5 root requires no unsafe native alias traversal.
    if(!row || (row&1) || Field<uint16_t>(row,2)!=5)return false;
    const int entries=Field<int>(bar,4);uintptr_t entry=0;
    for(int i=0;i<entries;++i) {
        const uintptr_t e=bar+16+SIZE_T(i)*16;
        if(Field<uint16_t>(e,0)==2 && Field<unsigned>(e,4)==0x00646D63) {entry=e;break;}
    }
    if(!entry)return false;
    out.bar=bar;out.table=span.data;out.row=row;out.entry=entry;out.bytes=bytes;
    memcpy(out.allocation,reinterpret_cast<void*>(bar-16),sizeof(out.allocation));
    memcpy(out.barHeader,reinterpret_cast<void*>(bar),sizeof(out.barHeader));
    memcpy(out.entryBytes,reinterpret_cast<void*>(entry),sizeof(out.entryBytes));
    memcpy(out.tableHeader,reinterpret_cast<void*>(span.data),sizeof(out.tableHeader));
