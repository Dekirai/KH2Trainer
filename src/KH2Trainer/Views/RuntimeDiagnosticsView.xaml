<UserControl x:Class="KH2Trainer.RuntimeDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
 <UserControl.Resources>
  <Style x:Key="Caption" TargetType="Border"><Setter Property="Background" Value="{StaticResource InputBrush}"/><Setter Property="BorderBrush" Value="{StaticResource StrongLineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="5*" MinWidth="240"/><ColumnDefinition Width="16"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>

  <!-- Catalog -->
  <DockPanel>
   <TextBlock DockPanel.Dock="Top" Text="Eight error messages and three exit prompts. Offline reference: reading them never opens a game dialog." Style="{StaticResource Text.Muted}" Margin="0,0,0,12"/>
   <TextBox DockPanel.Dock="Top" x:Name="DiagnosticFilter" Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Search}" Tag="Search all six languages"
            ToolTip="Search by message number, title, original text, button caption or behavior" AutomationProperties.Name="Search game messages" Margin="0,0,0,8"/>
   <TextBlock DockPanel.Dock="Top" Text="{Binding CountText}" Style="{StaticResource Text.Small}" Margin="2,0,0,8"/>
   <ListBox x:Name="DiagnosticList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry,Mode=TwoWay}" Style="{StaticResource List}" ItemContainerStyle="{StaticResource ListRow}"
            MinHeight="200" AutomationProperties.Name="Game messages and exit prompts">
    <ListBox.ItemTemplate><DataTemplate>
     <StackPanel Margin="0,1">
      <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Identity}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
     </StackPanel>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel>

  <!-- Details -->
  <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
   <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18">
    <StackPanel>
     <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource Text.CardTitle}" FontSize="18"/>
     <TextBlock Text="{Binding SelectedIdentity}" Style="{StaticResource Text.Small}" Margin="0,4,0,10"/>
     <TextBlock Text="{Binding SelectedSummary}" Style="{StaticResource Text.Muted}" Margin="0,0,0,16"/>
     <StackPanel Visibility="{Binding HasSelection,Converter={StaticResource BoolVisibility}}">
      <DockPanel Margin="0,0,0,10">
       <ComboBox x:Name="DiagnosticLanguage" DockPanel.Dock="Right" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage,Mode=TwoWay}" Width="180" AutomationProperties.Name="Original message language">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
       </ComboBox>
       <TextBlock Text="ORIGINAL TEXT" Style="{StaticResource Text.Overline}" VerticalAlignment="Center" Margin="0"/>
      </DockPanel>
      <TextBox x:Name="DiagnosticText" Text="{Binding OriginalText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="230" VerticalScrollBarVisibility="Auto"
               VerticalContentAlignment="Top" FontSize="15" Padding="14,12" AutomationProperties.Name="Original game message"/>

      <TextBlock Text="BUTTON CAPTIONS IN THE GAME" Style="{StaticResource Text.Overline}" Margin="0,18,0,8"/>
      <WrapPanel>
       <Border Style="{StaticResource Caption}"><TextBlock Text="{Binding PrimaryButtonText}" TextWrapping="Wrap"/></Border>
       <Border Style="{StaticResource Caption}" Visibility="{Binding HasSecondaryButton,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding SecondaryButtonText}" TextWrapping="Wrap"/></Border>
      </WrapPanel>

      <TextBlock Text="WHAT THE GAME DOES" Style="{StaticResource Text.Overline}" Margin="0,12,0,8"/>
      <StackPanel Visibility="{Binding IsRuntimeMessage,Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="First button" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding PrimaryEffect}" Style="{StaticResource Text.Muted}" Margin="0,4,0,10"/>
       <StackPanel Visibility="{Binding HasSecondaryButton,Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="Second button" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding SecondaryEffect}" Style="{StaticResource Text.Muted}" Margin="0,4,0,10"/>
       </StackPanel>
      </StackPanel>
      <TextBlock Text="{Binding PromptBehavior}" Style="{StaticResource Text.Muted}" Visibility="{Binding IsClosePrompt,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10"/>

      <Expander x:Name="DiagnosticSourceDetails" Header="Source details and native behavior" Margin="-4,8,0,0">
       <StackPanel Margin="4,0,0,0">
        <TextBlock Text="These original addresses and research references identify the evidence behind this entry." Style="{StaticResource Text.Muted}" Margin="0,0,0,10"/>
        <TextBox Text="{Binding SourceAnchors,Mode=OneWay}" Style="{StaticResource TextBox.Code}" TextWrapping="Wrap" MaxHeight="260" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Diagnostic source addresses"/>
        <TextBlock Text="SHARED ERROR-DIALOG PATH" Style="{StaticResource Text.Overline}" Margin="0,14,0,8" Visibility="{Binding IsRuntimeMessage,Converter={StaticResource BoolVisibility}}"/>
        <TextBlock Text="{Binding SharedNativeBehavior}" Style="{StaticResource Text.Muted}" Visibility="{Binding IsRuntimeMessage,Converter={StaticResource BoolVisibility}}"/>
        <TextBlock Text="SOURCE EXECUTABLE SHA-256" Style="{StaticResource Text.Overline}" Margin="0,14,0,8"/>
        <TextBox Text="{Binding SourceSha256,Mode=OneWay}" Style="{StaticResource TextBox.Code}" TextWrapping="Wrap"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</UserControl>
