<UserControl x:Class="KH2Trainer.TwitchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KH2Trainer">
 <UserControl.Resources>
  <Style x:Key="Step" TargetType="TextBlock" BasedOn="{StaticResource Text.Overline}"><Setter Property="Margin" Value="2,18,0,8"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Overline}"><Setter Property="Margin" Value="2,0,0,6"/></Style>
  <Style x:Key="Bullet" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}"><Setter Property="Margin" Value="10,2,0,2"/></Style>
  <Style x:Key="Chromeless" TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Reward picture: the chosen image, or the category colour with a symbol. -->
  <DataTemplate x:Key="RewardPicture">
   <Grid Width="44" Height="44">
    <Border CornerRadius="8" Background="{Binding Brush}" Visibility="{Binding HasNoImage,Converter={StaticResource BoolVisibility}}">
     <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
    </Border>
    <Border CornerRadius="8" Visibility="{Binding HasImage,Converter={StaticResource BoolVisibility}}">
     <Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/></Border.Background>
    </Border>
   </Grid>
  </DataTemplate>

  <!-- Details of one reward, created only when it is expanded. -->
  <DataTemplate x:Key="RewardDetails">
   <StackPanel Margin="56,14,4,4">
    <local:AdaptiveGrid MinColumnWidth="190" MaxColumns="4" ColumnSpacing="12" RowSpacing="12">
     <StackPanel>
      <TextBlock Text="COST (CHANNEL POINTS)" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Cost,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Cost"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsTimed,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="DURATION (SECONDS)" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Duration,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Duration in seconds"/>
     </StackPanel>
     <StackPanel Visibility="{Binding HasAmount,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="{Binding AmountLabel}" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AmountLabel}"/>
      <TextBox Text="{Binding Amount,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Amount"/>
     </StackPanel>
     <StackPanel>
      <TextBlock Text="COOLDOWN (SECONDS)" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding Cooldown,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Cooldown in seconds" ToolTip="Time after a redemption before anyone can redeem it again. 0 = none."/>
     </StackPanel>
     <StackPanel>
      <TextBlock Text="MAX PER STREAM" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding MaxPerStream,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Maximum per stream" ToolTip="0 = no limit."/>
     </StackPanel>
     <StackPanel>
      <TextBlock Text="MAX PER VIEWER PER STREAM" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding MaxPerUserPerStream,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Maximum per viewer per stream" ToolTip="0 = no limit."/>
     </StackPanel>
    </local:AdaptiveGrid>

    <TextBlock Text="TITLE ON TWITCH" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
    <TextBox Text="{Binding Title,UpdateSourceTrigger=LostFocus}" MaxLength="45" AutomationProperties.Name="Title on Twitch"/>
    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource DimBrush}" Margin="2,4,0,0">Empty uses <Run Text="{Binding DefaultTitle,Mode=OneWay}"/>.</TextBlock>

    <TextBlock Text="DESCRIPTION ON TWITCH" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
    <TextBox Text="{Binding Prompt,UpdateSourceTrigger=LostFocus}" MaxLength="200" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="54" VerticalContentAlignment="Top" AutomationProperties.Name="Description on Twitch"/>
    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource DimBrush}" Margin="2,4,0,0">Empty uses the default text with the duration and amount: <Run Text="{Binding DefaultPrompt,Mode=OneWay}"/></TextBlock>

    <local:AdaptiveGrid MinColumnWidth="280" MaxColumns="2" ColumnSpacing="12" RowSpacing="12" Margin="0,14,0,0">
     <StackPanel Visibility="{Binding IsTimed,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="REDEEMED AGAIN WHILE IT RUNS" Style="{StaticResource FieldLabel}"/>
      <ComboBox ItemsSource="{Binding SameEffectOptions}" SelectedItem="{Binding SameEffect}" DisplayMemberPath="Label" AutomationProperties.Name="Redeemed again while it runs"/>
     </StackPanel>
     <StackPanel Visibility="{Binding HasGroup,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="{Binding ConflictHint}" Style="{StaticResource FieldLabel}"/>
      <ComboBox ItemsSource="{Binding ConflictOptions}" SelectedItem="{Binding Conflict}" DisplayMemberPath="Label" AutomationProperties.Name="When a similar effect runs"/>
     </StackPanel>
    </local:AdaptiveGrid>

    <TextBlock Text="IMAGE" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
    <WrapPanel>
     <Button Content="Choose image…" Command="{Binding ChooseImageCommand}" Margin="0,0,8,8"/>
     <Button Content="Show file" Command="{Binding ShowImageCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,8,8"/>
     <Button Content="Remove image" Command="{Binding ClearImageCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,8,8"/>
     <Button Content="Reset to defaults" Command="{Binding ResetCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,8,8"/>
    </WrapPanel>
    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource DimBrush}" Text="The image shows here and in the stream overlay. Twitch does not let apps upload reward icons; to use it on Twitch too, upload the same file in your reward dashboard."/>
   </StackPanel>
  </DataTemplate>

  <!-- One reward row. -->
  <DataTemplate x:Key="RewardRow">
   <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8" Visibility="{Binding IsVisible,Converter={StaticResource BoolVisibility}}">
    <StackPanel>
     <DockPanel>
      <Button DockPanel.Dock="Left" Style="{StaticResource Chromeless}" Command="{Binding ChooseImageCommand}" Content="{Binding}" ContentTemplate="{StaticResource RewardPicture}"
              VerticalAlignment="Top" ToolTip="Choose an image for this reward" AutomationProperties.Name="Choose image"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Style="{StaticResource Button.Subtle}" Command="{Binding TestCommand}" ToolTip="Run this effect in the game now, without Twitch" Margin="0,0,4,0">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="Test"/></StackPanel>
       </Button>
       <Button Style="{StaticResource Button.Subtle}" Command="{Binding ToggleCommand}" ToolTip="Edit cost, duration, title, behaviour and image" Margin="0,0,10,0">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="Edit"/></StackPanel>
       </Button>
       <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" AutomationProperties.Name="{Binding DisplayTitle}"
                 ToolTip="On creates the reward on your channel, off deletes it."/>
      </StackPanel>
      <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
       <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
       <WrapPanel Margin="0,4,0,0">
        <TextBlock Text="{Binding Info}" Style="{StaticResource Text.Small}" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
        <Border Visibility="{Binding ShowStatus,Converter={StaticResource BoolVisibility}}">
         <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Badge}">
           <Style.Triggers>
            <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding StatusIsLive}" Value="True"><Setter Property="Background" Value="#1E3B2C"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
         <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" MaxWidth="460"/>
        </Border>
       </WrapPanel>
      </StackPanel>
     </DockPanel>
     <ContentControl Content="{Binding}" Focusable="False">
      <ContentControl.Style>
       <Style TargetType="ContentControl">
        <Setter Property="ContentTemplate" Value="{x:Null}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsExpanded}" Value="True">
          <Setter Property="ContentTemplate" Value="{StaticResource RewardDetails}"/>
          <Setter Property="Visibility" Value="Visible"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </ContentControl.Style>
     </ContentControl>
    </StackPanel>
   </Border>
  </DataTemplate>
 </UserControl.Resources>

 <DockPanel>
  <ListBox DockPanel.Dock="Top" Style="{StaticResource TabStrip}" SelectedIndex="{Binding SelectedTab}" Margin="0,0,0,18" AutomationProperties.Name="Twitch tabs">
   <ListBoxItem><TextBlock Text="Setup" FontSize="14"/></ListBoxItem>
   <ListBoxItem><TextBlock Text="Rewards" FontSize="14"/></ListBoxItem>
   <ListBoxItem><TextBlock Text="{Binding LiveTabTitle}" FontSize="14"/></ListBoxItem>
  </ListBox>

  <Grid>
   <!-- SETUP -->
   <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="{Binding IsSetupTab,Converter={StaticResource BoolVisibility}}">
    <StackPanel Margin="0,0,0,24">
     <Border Style="{StaticResource Banner.Warning}" Margin="0,0,0,14" Visibility="{Binding HasLoadProblem,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="{Binding LoadProblem}" TextWrapping="Wrap"/>
     </Border>
     <local:AdaptiveGrid MinColumnWidth="420" MaxColumns="2" ColumnSpacing="14" RowSpacing="14">

      <!-- Connection -->
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <StackPanel Orientation="Horizontal">
         <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
         <TextBlock Text="{Binding ConnectionTitle}" Style="{StaticResource Text.CardTitle}" Margin="10,0,0,0"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>

        <StackPanel Visibility="{Binding ShowClientIdStep,Converter={StaticResource BoolVisibility}}">
         <TextBlock Text="1   CREATE A FREE TWITCH APP (ONCE)" Style="{StaticResource Step}"/>
         <TextBlock Style="{StaticResource Text.Small}" Text="Register an application in the Twitch developer console with these settings:"/>
         <TextBlock Style="{StaticResource Bullet}">• Name: anything, for example <Run Text="KH2 Trainer YourName" FontWeight="SemiBold"/></TextBlock>
         <TextBlock Style="{StaticResource Bullet}">• OAuth Redirect URLs: <Run Text="http://localhost" FontWeight="SemiBold"/></TextBlock>
         <TextBlock Style="{StaticResource Bullet}">• Category: <Run Text="Application Integration" FontWeight="SemiBold"/></TextBlock>
         <TextBlock Style="{StaticResource Bullet}">• Client Type: <Run Text="Public" FontWeight="SemiBold"/></TextBlock>
         <Button Content="Open Twitch developer console" Command="{Binding OpenDeveloperConsoleCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>

         <TextBlock Text="2   PASTE ITS CLIENT ID" Style="{StaticResource Step}"/>
         <TextBox Text="{Binding ClientId,UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Twitch Client ID"/>
        </StackPanel>

        <TextBlock Text="{Binding ConnectStepTitle}" Style="{StaticResource Step}"/>
        <TextBlock Style="{StaticResource Text.Small}" Text="Twitch opens in your browser and asks you to allow the trainer to manage channel point rewards. The login is stored encrypted on this PC."/>

        <Border Style="{StaticResource Banner}" Margin="0,12,0,0" Visibility="{Binding IsWaitingForCode,Converter={StaticResource BoolVisibility}}">
         <StackPanel>
          <TextBlock Text="Confirm this code on Twitch:" Style="{StaticResource Text.Muted}"/>
          <TextBlock Text="{Binding UserCode}" FontFamily="{StaticResource MonoFont}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Margin="0,4,0,10"/>
          <WrapPanel>
           <Button Content="Open twitch.tv/activate" Command="{Binding OpenActivationCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
           <Button Content="Copy code" Command="{Binding CopyCodeCommand}" Margin="0,0,8,0"/>
           <Button Content="Cancel" Command="{Binding CancelConnectCommand}" Style="{StaticResource Button.Subtle}"/>
          </WrapPanel>
         </StackPanel>
        </Border>

        <WrapPanel Margin="0,14,0,0">
         <Button Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}" Style="{StaticResource Button.Primary}" MinWidth="150" Margin="0,0,8,8"
                 Visibility="{Binding ShowConnectButton,Converter={StaticResource BoolVisibility}}"/>
         <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="0,0,8,8" Visibility="{Binding IsConnected,Converter={StaticResource BoolVisibility}}"/>
         <Button Content="Log out" Command="{Binding LogoutCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,8,8"/>
        </WrapPanel>
        <TextBlock Text="{Binding EventSubText}" Style="{StaticResource Text.Small}"/>
        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource DimBrush}" Margin="0,6,0,0" Text="Channel points need Twitch Affiliate or Partner status."/>
       </StackPanel>
      </Border>

      <!-- Behaviour -->
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="How redemptions behave" Style="{StaticResource Text.CardTitle}"/>
        <TextBlock Text="These defaults apply to every reward. Each reward can override them under Edit." Style="{StaticResource Text.Muted}" Margin="0,6,0,14"/>

        <TextBlock Text="AN EFFECT IS REDEEMED AGAIN WHILE IT RUNS" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding SameEffectOptions}" SelectedItem="{Binding SameEffect}" DisplayMemberPath="Label" AutomationProperties.Name="An effect is redeemed again while it runs"/>
        <TextBlock Text="A SIMILAR EFFECT RUNS (FOR EXAMPLE ANOTHER DRIVE FORM)" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
        <ComboBox ItemsSource="{Binding ConflictOptions}" SelectedItem="{Binding Conflict}" DisplayMemberPath="Label" AutomationProperties.Name="A similar effect runs"/>
        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource DimBrush}" Margin="2,6,0,0"
                   Text="Example: Final Form runs and another viewer redeems Valor Form. With queueing, Valor Form starts as soon as Final Form ends."/>

        <local:AdaptiveGrid MinColumnWidth="170" MaxColumns="2" ColumnSpacing="12" Margin="0,14,0,0">
         <StackPanel>
          <TextBlock Text="REFUND AFTER WAITING (MINUTES)" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding MaxWaitMinutes,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Refund after waiting, in minutes"/>
         </StackPanel>
         <StackPanel>
          <TextBlock Text="LONGEST EFFECT (SECONDS)" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding MaxDurationSeconds,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Longest effect, in seconds"
                   ToolTip="Caps reward durations and how far extensions can add up."/>
         </StackPanel>
        </local:AdaptiveGrid>

        <CheckBox Content="Pause effect timers during loading, menus and cutscenes" IsChecked="{Binding PauseTimersWhileNotReady}" Style="{StaticResource Switch}" Margin="0,16,0,0"/>
        <CheckBox Content="Pause the rewards on Twitch while the trainer is closed" IsChecked="{Binding PauseRewardsWhenClosed}" Style="{StaticResource Switch}" Margin="0,10,0,0"/>

        <TextBlock Text="REWARD TEXTS ON TWITCH" Style="{StaticResource FieldLabel}" Margin="2,16,0,6"/>
        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="Reward language"/>
       </StackPanel>
      </Border>
     </local:AdaptiveGrid>

     <!-- Overlay -->
     <Border Style="{StaticResource Card}" Margin="0,14,0,0">
      <StackPanel>
       <DockPanel>
        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding OverlayEnabled}" VerticalAlignment="Center" AutomationProperties.Name="Stream overlay"/>
        <TextBlock Text="Stream overlay" Style="{StaticResource Text.CardTitle}"/>
       </DockPanel>
       <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,14"
                  Text="Shows running effects with their timer, the queue and who redeemed what. In OBS add a Browser Source with this URL (for example 500 × 700). Add ?side=left to align it left, ?queue=0 to hide the queue or ?scale=1.5 to enlarge it."/>
       <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <TextBlock Text="PORT" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="12,0,8,0"/>
         <TextBox Text="{Binding OverlayPort,UpdateSourceTrigger=LostFocus}" Width="80" AutomationProperties.Name="Overlay port"/>
         <Button Content="Copy URL" Command="{Binding CopyOverlayCommand}" Margin="8,0,0,0"/>
         <Button Content="Preview" Command="{Binding OpenOverlayCommand}" Style="{StaticResource Button.Subtle}" Margin="4,0,0,0"/>
        </StackPanel>
        <TextBox Text="{Binding OverlayUrl,Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Overlay URL"/>
       </DockPanel>
       <TextBlock Text="{Binding OverlayStatus}" Style="{StaticResource Text.Small}" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>

   <!-- REWARDS -->
   <DockPanel Visibility="{Binding IsRewardsTab,Converter={StaticResource BoolVisibility}}">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,6,12">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <CheckBox Content="Only switched on" IsChecked="{Binding ShowEnabledOnly}" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}" Margin="0,0,8,0" ToolTip="Paused rewards stay visible on Twitch but cannot be redeemed."/>
      <Button Content="Sync now" Command="{Binding ResyncCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,4,0" ToolTip="Bring every reward on Twitch in line with this list."/>
      <Button Content="Reward dashboard" Command="{Binding OpenDashboardCommand}" Style="{StaticResource Button.Subtle}" ToolTip="Open your channel point rewards on Twitch, for example to upload icons."/>
     </StackPanel>
     <TextBox Style="{StaticResource TextBox.Search}" Tag="Filter rewards" MinWidth="160" MaxWidth="280" HorizontalAlignment="Left" Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged,Delay=150}" AutomationProperties.Name="Filter rewards">
      <TextBox.InputBindings><KeyBinding Key="Escape" Command="{Binding ClearFilterCommand}"/></TextBox.InputBindings>
     </TextBox>
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding RewardSummary}" Style="{StaticResource Text.Small}" Margin="2,0,6,10"/>
    <Border DockPanel.Dock="Top" Style="{StaticResource Banner.Warning}" Margin="0,0,6,10" Visibility="{Binding OverLimit,Converter={StaticResource BoolVisibility}}">
     <TextBlock Text="{Binding LimitText}" TextWrapping="Wrap"/>
    </Border>
    <Border DockPanel.Dock="Top" Style="{StaticResource Banner.Error}" Margin="0,0,6,10" Visibility="{Binding HasSyncError,Converter={StaticResource BoolVisibility}}">
     <TextBlock Text="{Binding SyncError}" TextWrapping="Wrap"/>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
     <StackPanel Margin="0,0,0,24">
      <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource DimBrush}" Margin="2,0,0,14"
                 Text="Switch a reward on to create it on your channel and off to delete it. Edits reach Twitch a moment after you leave a field. Test runs an effect in the game without spending points."/>
      <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <StackPanel Margin="0,0,0,18" Visibility="{Binding HasVisible,Converter={StaticResource BoolVisibility}}">
          <DockPanel Margin="2,0,0,10">
           <Border DockPanel.Dock="Left" Width="4" Height="18" CornerRadius="2" Background="{Binding Brush}" Margin="0,0,10,0"/>
           <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Text.Small}" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
           <TextBlock VerticalAlignment="Center">
            <Run Text="{Binding Title,Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/>
            <Run Text="{Binding Description,Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
           </TextBlock>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Rewards}" ItemTemplate="{StaticResource RewardRow}" Focusable="False"/>
         </StackPanel>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="No rewards match the filter." Style="{StaticResource Text.Muted}" Visibility="{Binding HasNoMatches,Converter={StaticResource BoolVisibility}}"/>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>

   <!-- LIVE -->
   <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="{Binding IsLiveTab,Converter={StaticResource BoolVisibility}}">
    <StackPanel Margin="0,0,0,24">
     <Border Margin="0,0,0,14">
      <Border.Style>
       <Style TargetType="Border" BasedOn="{StaticResource Banner}">
        <Style.Triggers><DataTrigger Binding="{Binding GameReady}" Value="False"><Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/><Setter Property="BorderBrush" Value="#5A4520"/></DataTrigger></Style.Triggers>
       </Style>
      </Border.Style>
      <DockPanel>
       <Button DockPanel.Dock="Right" Content="Stop all and refund waiting" Command="{Binding StopAllCommand}" Style="{StaticResource Button.Danger}" Margin="12,0,0,0" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding GameText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
     </Border>

     <local:AdaptiveGrid MinColumnWidth="380" MaxColumns="2" ColumnSpacing="14" RowSpacing="14">
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="Running now" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,12"/>
        <TextBlock Text="Nothing is running.">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}"><Style.Triggers><DataTrigger Binding="{Binding HasActive}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding ActiveEffects}" Focusable="False">
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <DockPanel Margin="0,0,0,12">
            <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top">
             <Border CornerRadius="8" Background="{Binding Brush}" Visibility="{Binding HasNoImage,Converter={StaticResource BoolVisibility}}"/>
             <Border CornerRadius="8" Visibility="{Binding HasImage,Converter={StaticResource BoolVisibility}}">
              <Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/></Border.Background>
             </Border>
            </Grid>
            <Button DockPanel.Dock="Right" Content="End" Command="{Binding EndCommand}" Style="{StaticResource Button.Subtle}" VerticalAlignment="Top" ToolTip="End this effect now"/>
            <StackPanel>
             <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" ToolTip="{Binding PauseReason}" Style="{StaticResource Text.Small}" Margin="8,0,0,0"/>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
             </DockPanel>
             <TextBlock Style="{StaticResource Text.Small}" Margin="0,2,0,4">
              <Run Text="{Binding Viewers,Mode=OneWay}"/><Run Text="{Binding Detail,Mode=OneWay,StringFormat=' · {0}'}"/>
             </TextBlock>
             <ProgressBar Style="{StaticResource Meter}" Value="{Binding Fraction,Mode=OneWay}" Foreground="{Binding Brush}" Visibility="{Binding IsTimed,Converter={StaticResource BoolVisibility}}"/>
            </StackPanel>
           </DockPanel>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="Waiting" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,12"/>
        <TextBlock Text="No redemption is waiting.">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}"><Style.Triggers><DataTrigger Binding="{Binding HasPending}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding PendingEffects}" Focusable="False">
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <DockPanel Margin="0,0,0,10">
            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding Brush}" Margin="0,5,12,0" VerticalAlignment="Top"/>
            <Button DockPanel.Dock="Right" Content="Refund" Command="{Binding RefundCommand}" Style="{StaticResource Button.Subtle}" VerticalAlignment="Top" ToolTip="Remove it from the queue and give the points back"/>
            <StackPanel>
             <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Waited}" Style="{StaticResource Text.Small}" Margin="8,0,0,0"/>
              <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Title,Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Viewer,Mode=OneWay,StringFormat=' · {0}'}" Foreground="{StaticResource MutedBrush}"/></TextBlock>
             </DockPanel>
             <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
            </StackPanel>
           </DockPanel>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Border>
     </local:AdaptiveGrid>

     <Border Style="{StaticResource Card}" Margin="0,14,0,0">
      <StackPanel>
       <TextBlock Text="Recent" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,12"/>
       <TextBlock Text="Redemptions and their results appear here.">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}"><Style.Triggers><DataTrigger Binding="{Binding HasEvents}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <ItemsControl ItemsSource="{Binding Events}" Focusable="False">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <DockPanel Margin="0,0,0,6">
           <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,0,12,0" VerticalAlignment="Top"/>
           <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{Binding Brush}" Margin="0,2,10,0" VerticalAlignment="Top"/>
           <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
          </DockPanel>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</UserControl>
