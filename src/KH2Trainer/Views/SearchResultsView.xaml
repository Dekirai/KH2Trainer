<UserControl x:Class="KH2Trainer.SearchResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Focusable="False">
   <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource FeatureGroupTemplate}" Focusable="False"/>
  </ScrollViewer>
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" Visibility="{Binding IsEmpty,Converter={StaticResource BoolVisibility}}">
   <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="32" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"/>
   <TextBlock Text="No matching features" Style="{StaticResource Text.CardTitle}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
   <TextBlock Text="Try a shorter word, such as “HP”, “camera” or “drive”. Press Esc to clear the search." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"/>
  </StackPanel>
 </Grid>
</UserControl>
