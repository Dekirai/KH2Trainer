<UserControl x:Class="KH2Trainer.AssetExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <!-- Sources -->
  <WrapPanel Margin="0,0,0,4">
   <Button Content="Open loose asset…" Command="{Binding OpenLooseCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,8"/>
   <Button Content="Open package index…" Command="{Binding OpenPackageCommand}" Margin="0,0,8,8" ToolTip="Open a retail .hed index. Its .pkg must be in the same folder."/>
   <Button Content="Name list…" Command="{Binding ChooseNamesCommand}" Margin="0,0,8,8" ToolTip="Optional text file with asset paths, one per line. Choose it before opening an index to resolve package hashes."/>
   <Button Content="Clear name list" Command="{Binding ClearNamesCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,8,8"/>
   <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,8,8"/>
  </WrapPanel>
  <Border Grid.Row="1" Style="{StaticResource Banner}" Margin="0,0,0,14">
   <StackPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding NamesFileLabel}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"/>
   </StackPanel>
  </Border>

  <TabControl x:Name="AssetTabs" Grid.Row="2">
   <TabItem Header="Browse">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="140"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10">
      <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0">
       <Button Command="{Binding BackCommand}" Margin="0,0,8,6" ToolTip="Return to the parent container">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="Back"/></StackPanel>
       </Button>
       <Button Content="Open" Command="{Binding InspectCommand}" Margin="0,0,8,6" ToolTip="Inspect the selected entry or open a nested container"/>
       <Button Content="Export…" Command="{Binding ExportCommand}" Margin="0,0,8,6" ToolTip="Export the selected entry to a new file"/>
       <Button Content="Export container…" Command="{Binding ExportContainerCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,0,6" ToolTip="Export the whole container that is open"/>
      </WrapPanel>
      <StackPanel>
       <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
       <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"/>
      </StackPanel>
     </DockPanel>
     <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <TextBox Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Search}" Tag="Filter by name, hash, tag or type" IsEnabled="{Binding Idle}" AutomationProperties.Name="Filter assets"/>
     </DockPanel>
     <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsEnabled="{Binding Idle}" Style="{StaticResource List}" ItemContainerStyle="{StaticResource ListRow}" AutomationProperties.Name="Asset entries">
      <ListBox.ItemTemplate><DataTemplate>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
        <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{StaticResource MutedBrush}" Margin="10,0" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Grid Grid.Row="3" Height="200" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="180"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="14,12">
       <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="SELECTION" Style="{StaticResource Text.Overline}" Margin="0,0,0,6"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding SelectionDetails}" Style="{StaticResource Text.Muted}"/></ScrollViewer>
       </DockPanel>
      </Border>
      <DockPanel Grid.Column="2">
       <TextBlock DockPanel.Dock="Top" Text="BYTE PREVIEW · FIRST 4 KiB" Style="{StaticResource Text.Overline}" Margin="2,0,0,6"/>
       <TextBox Text="{Binding Preview,Mode=OneWay}" Style="{StaticResource TextBox.Code}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" AutomationProperties.Name="Byte preview"/>
      </DockPanel>
     </Grid>
    </Grid>
   </TabItem>

   <TabItem Header="Compare content">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="180"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,12">
      <TextBlock Text="Keep fingerprints of selected assets and find payloads with identical content across archives. Only the selected payload is read; names and nested locations stay distinct." Style="{StaticResource Text.Muted}" Margin="0,0,0,12"/>
      <TextBlock Text="SOURCE LABEL" Style="{StaticResource Text.Overline}"/>
      <TextBox Text="{Binding SourceLabel,UpdateSourceTrigger=PropertyChanged}" MaxLength="512" IsEnabled="{Binding Idle}" Width="340" HorizontalAlignment="Left" AutomationProperties.Name="Source label"
               ToolTip="A portable label, such as Original KH2 or My modified assets. Use different labels for unrelated sources."/>
      <WrapPanel Margin="0,12,0,0">
       <Button Content="Add selected" Command="{Binding CaptureFingerprintCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,8"/>
       <Button Content="Add current container" Command="{Binding CaptureContainerFingerprintCommand}" Margin="0,0,8,8"/>
       <Button Content="Find matches for selected" Command="{Binding CompareFingerprintCommand}" Margin="0,0,20,8"/>
       <Button Content="Load index…" Command="{Binding LoadFingerprintIndexCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,4,8" ToolTip="Loading replaces the in-memory list."/>
       <Button Content="Save as new index…" Command="{Binding SaveFingerprintIndexCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,4,8" ToolTip="Saving requires a new local file outside game folders."/>
       <Button Content="Clear list" Command="{Binding ClearFingerprintIndexCommand}" Style="{StaticResource Button.Subtle}" Margin="0,0,4,8" ToolTip="Clears only the in-memory list. Saved files are unchanged."/>
      </WrapPanel>
      <TextBlock Text="{Binding FingerprintStatus}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
     </StackPanel>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel>
       <TextBlock DockPanel.Dock="Top" Text="{Binding FingerprintCountText}" Style="{StaticResource Text.Overline}" Margin="2,0,0,6"/>
       <ListBox ItemsSource="{Binding FingerprintRows}" SelectedItem="{Binding SelectedFingerprint}" IsEnabled="{Binding Idle}" Style="{StaticResource List}" ItemContainerStyle="{StaticResource ListRow}" AutomationProperties.Name="Fingerprints">
        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </DockPanel>
      <DockPanel Grid.Column="2">
       <TextBlock DockPanel.Dock="Top" Text="MATCHING FINGERPRINTS" Style="{StaticResource Text.Overline}" Margin="2,0,0,6"/>
       <ListBox ItemsSource="{Binding FingerprintMatches}" Style="{StaticResource List}" ItemContainerStyle="{StaticResource ListRow}" AutomationProperties.Name="Matching fingerprints">
        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Location}" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </DockPanel>
     </Grid>
     <Expander x:Name="FingerprintDetailsExpander" Grid.Row="2" Header="Fingerprint details" Margin="0,10,0,0">
      <TextBox Text="{Binding FingerprintDetails,Mode=OneWay}" Style="{StaticResource TextBox.Code}" TextWrapping="Wrap" MinHeight="80" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Fingerprint details"/>
     </Expander>
    </Grid>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
