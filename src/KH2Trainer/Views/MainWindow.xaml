<Window x:Class="KH2Trainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KH2Trainer"
        Title="KH2 Trainer" Width="1260" Height="840" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <CollectionViewSource x:Key="PageGroups" Source="{Binding Pages}">
   <CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group"/></CollectionViewSource.GroupDescriptions>
  </CollectionViewSource>

  <DataTemplate DataType="{x:Type local:HomeVm}"><local:HomeView/></DataTemplate>
  <DataTemplate DataType="{x:Type local:FeatureSectionVm}"><local:FeatureSectionView/></DataTemplate>
  <DataTemplate DataType="{x:Type local:SearchResultsVm}"><local:SearchResultsView/></DataTemplate>
  <DataTemplate DataType="{x:Type local:ProfilesVm}"><local:ProfilesView/></DataTemplate>
  <DataTemplate DataType="{x:Type local:AboutVm}"><local:AboutView/></DataTemplate>
  <DataTemplate DataType="{x:Type local:AssetExplorerViewModel}"><local:AssetExplorerView/></DataTemplate>
  <DataTemplate DataType="{x:Type local:RuntimeDiagnosticsViewModel}"><local:RuntimeDiagnosticsView/></DataTemplate>
  <DataTemplate DataType="{x:Type local:TwitchVm}"><local:TwitchView/></DataTemplate>

  <!-- Sidebar entries: icon and title, with an accent bar on the selected page. -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid Margin="10,1">
     <Border x:Name="Back" CornerRadius="7" Background="Transparent"/>
     <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Visibility="Hidden"/>
     <ContentPresenter Margin="12,8,10,8"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Back" Property="Background" Value="{StaticResource HoverBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Back" Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Back" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Window.CommandBindings>
  <CommandBinding Command="ApplicationCommands.Find" Executed="FocusSearch"/>
 </Window.CommandBindings>

 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- Sidebar -->
  <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,16,16">
     <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" BorderBrush="#2B4670" BorderThickness="1">
      <TextBlock Text="KH" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="KH2 Trainer" FontWeight="SemiBold" FontSize="15"/>
      <TextBlock Text="Final Mix · Steam · x64" Style="{StaticResource Text.Small}" Foreground="{StaticResource DimBrush}"/>
     </StackPanel>
    </StackPanel>

    <!-- Connection -->
    <Border DockPanel.Dock="Bottom" Margin="12,8,12,14" Padding="14,12" CornerRadius="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
     <StackPanel>
      <StackPanel Orientation="Horizontal">
       <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding ConnectionTitle}" FontWeight="SemiBold" Margin="9,0,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding ConnectionDetail}" Style="{StaticResource Text.Small}" Margin="18,3,0,10"/>
      <Button Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Stretch"
              Visibility="{Binding ShowConnectButton,Converter={StaticResource BoolVisibility}}"/>
      <Button Command="{Binding StartGameCommand}" HorizontalAlignment="Stretch" Visibility="{Binding ShowStartButton,Converter={StaticResource BoolVisibility}}">
       <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Start game"/></StackPanel>
      </Button>
     </StackPanel>
    </Border>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionLabel}" Style="{StaticResource Text.Small}" Foreground="{StaticResource DimBrush}" Margin="24,0,0,0"/>

    <ListBox x:Name="Navigation" ItemsSource="{Binding Source={StaticResource PageGroups}}" SelectedItem="{Binding SelectedPage}" ItemContainerStyle="{StaticResource NavItem}" PreviewMouseLeftButtonUp="NavigationClicked"
             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Sections">
     <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
     <ListBox.GroupStyle>
      <GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
       <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Overline}" Margin="24,14,0,6"/>
      </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle>
     </ListBox.GroupStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="{Binding Icon}" Style="{StaticResource Text.Icon}" Width="22"/>
       <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>

  <!-- Main area -->
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <Grid Margin="32,22,32,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,24,0">
     <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource Text.PageTitle}"/>
     <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
     <CheckBox Content="Descriptions" IsChecked="{Binding ShowDescriptions}" Style="{StaticResource Switch}" Margin="0,0,18,0" VerticalAlignment="Center"
               ToolTip="Show each feature's description below its name. Hover a name to read it at any time."/>
     <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Search}" Tag="Search all features  (Ctrl+F)" Width="290"
              Text="{Binding Search,UpdateSourceTrigger=PropertyChanged,Delay=150}" AutomationProperties.Name="Search all features">
      <TextBox.InputBindings><KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}"/></TextBox.InputBindings>
     </TextBox>
    </StackPanel>
   </Grid>

   <StackPanel Grid.Row="1" Margin="32,0,32,6">
    <!-- Errors and confirmations -->
    <Border Visibility="{Binding HasNotification,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8">
     <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Banner}"><Style.Triggers><DataTrigger Binding="{Binding NotificationIsError}" Value="True"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter Property="BorderBrush" Value="#5E2A33"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Command="{Binding DismissNotificationCommand}" ToolTip="Dismiss" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"/>
      <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0"/>
      <TextBlock Text="{Binding Notification}" TextWrapping="Wrap" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
    <!-- Why controls are locked -->
    <Border Visibility="{Binding ShowBanner,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8">
     <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Banner}"><Style.Triggers><DataTrigger Binding="{Binding BannerIsWarning}" Value="True"><Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/><Setter Property="BorderBrush" Value="#5A4520"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
       <Button Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}" Style="{StaticResource Button.Primary}" MinHeight="28" Padding="12,3" Visibility="{Binding ShowConnectButton,Converter={StaticResource BoolVisibility}}"/>
       <Button Content="Start game" Command="{Binding StartGameCommand}" MinHeight="28" Padding="12,3" Visibility="{Binding ShowStartButton,Converter={StaticResource BoolVisibility}}"/>
      </StackPanel>
      <TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
      <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
   </StackPanel>

   <ContentControl Grid.Row="2" Content="{Binding CurrentContent}" Focusable="False" Margin="32,6,26,0"/>

   <!-- Activity drawer -->
   <Border Grid.Row="3" Height="190" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
           Visibility="{Binding IsActivityOpen,Converter={StaticResource BoolVisibility}}">
    <DockPanel Margin="32,10,32,8">
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button Content="Export log…" Command="{Binding ExportLogCommand}" Style="{StaticResource Button.Subtle}"/>
       <Button Command="{Binding ToggleActivityCommand}" Style="{StaticResource Button.Subtle}" ToolTip="Close" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
      </StackPanel>
      <TextBlock Text="SESSION ACTIVITY" Style="{StaticResource Text.Overline}" VerticalAlignment="Center" Margin="0"/>
     </DockPanel>
     <ListBox ItemsSource="{Binding Activity}" Style="{StaticResource List}" ItemContainerStyle="{StaticResource ListRow}" Background="Transparent" BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
    </DockPanel>
   </Border>

   <!-- Status bar -->
   <Border Grid.Row="4" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,3,20,3">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,16,0">
      <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="9,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
     <Button Grid.Column="1" Style="{StaticResource Button.Subtle}" Command="{Binding ToggleActivityCommand}" ToolTip="Show or hide the session activity log">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="&#xE81C;" Style="{StaticResource Text.Icon}" FontSize="12"/>
       <TextBlock Text="{Binding LastActivity}" FontSize="12" Margin="7,0,0,0" MaxWidth="460" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
